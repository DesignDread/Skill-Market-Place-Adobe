# Anti-Gravity Environment Variables

# Gemini API key — enables AI-powered claim extraction and
# Google Search grounding for corroboration checks.
# Without this, the audit falls back to regex extraction and
# skips corroboration (with an explicit degraded-mode finding).
GEMINI_API_KEY=your_gemini_api_key_here

# Port for the Next.js dashboard (default: 3000)
PORT=3000
